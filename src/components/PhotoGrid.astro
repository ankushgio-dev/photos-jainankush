---
interface Photo {
  slug: string;
  src: string;
  alt: string;
  category: string;
  location?: string;
  region?: string;
}

interface Props {
  photos: Photo[];
  showLocations?: boolean;
}

const { photos, showLocations = false } = Astro.props;
---

<div class="photo-grid columns-2 md:columns-3 gap-6 md:gap-8">
  {
    photos.map((photo, i) => (
      <a
        href={`/${photo.category}/${photo.slug}/`}
        class="photo-item group block break-inside-avoid mb-6 md:mb-8 fade-up"
        style={`animation-delay: ${Math.min(i * 0.04, 0.32)}s`}
        data-location={photo.location || ''}
        data-region={photo.region || ''}
        aria-label={`View ${photo.alt}`}
      >
        <div class="photo-frame relative overflow-hidden">
          <img
            src={photo.src}
            alt={photo.alt}
            loading={i < 6 ? 'eager' : 'lazy'}
            decoding="async"
            class="w-full h-auto transition-transform duration-700 ease-soft group-hover:scale-[1.02]"
          />
          <div class="absolute inset-0 bg-ink/0 group-hover:bg-ink/5 transition-colors duration-500 ease-soft pointer-events-none" />
        </div>
        {showLocations && photo.location && (
          <span class="eyebrow mt-3 block opacity-0 group-hover:opacity-100 transition-opacity duration-300 ease-soft">
            {photo.location}
          </span>
        )}
      </a>
    ))
  }
</div>
