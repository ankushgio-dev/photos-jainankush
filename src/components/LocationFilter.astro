---
interface Props {
  locations: string[];
}

const { locations } = Astro.props;
---

<div class="location-filter mb-12 md:mb-16 flex flex-wrap gap-2 md:gap-3">
  <button
    type="button"
    class="filter-chip filter-chip-active"
    data-filter="all"
  >
    All
  </button>
  {
    locations.map((loc) => (
      <button type="button" class="filter-chip" data-filter={loc}>
        {loc}
      </button>
    ))
  }
</div>

<script>
  const chips = document.querySelectorAll('.location-filter [data-filter]');
  const items = document.querySelectorAll('.photo-item');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filter = chip.getAttribute('data-filter');

      chips.forEach((c) => c.classList.remove('filter-chip-active'));
      chip.classList.add('filter-chip-active');

      items.forEach((item) => {
        const loc = item.getAttribute('data-location');
        const htmlItem = item as HTMLElement;
        if (filter === 'all' || loc === filter) {
          htmlItem.style.display = '';
        } else {
          htmlItem.style.display = 'none';
        }
      });
    });
  });
</script>
