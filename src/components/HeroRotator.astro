---
import { featuredPhotos } from '../data/photos.js';
import { site } from '../data/site.js';

const featured = featuredPhotos();
// Pick a random featured photo at build time. Since this is a static site,
// "per page load" needs JS — we render ALL featured photos but show one via JS,
// so each visit gets a fresh hero without a backend.
const heroSlugs = featured.map((p) => p.slug);
---

<section class="relative">
  <div class="max-w-gallery mx-auto px-6 md:px-10 pt-8 md:pt-12 pb-8 md:pb-12">
    <div class="grid grid-cols-12 gap-6 md:gap-10 items-end">
      <div class="col-span-12 md:col-span-5 lg:col-span-4 fade-up">
        <p class="eyebrow mb-3">Photographs by</p>
        <h1 class="display text-ink">
          {site.name}
        </h1>
        <p class="body-serif text-muted mt-4 max-w-prose">
          A small collection of moments — fields, faces, mountains, light. From Punjab and wherever the road leads next.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-3">
          <a
            href="#categories"
            class="inline-flex items-center gap-2 text-xs uppercase tracking-widest text-ink hover:text-accent transition-colors duration-300 ease-soft"
          >
            <span class="w-8 h-px bg-ink"></span>
            Browse the work
          </a>
          <a
            href={site.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs uppercase tracking-widest text-muted hover:text-ink transition-colors duration-300 ease-soft"
          >
            Instagram @{site.instagram}
          </a>
        </div>
      </div>

      <div class="col-span-12 md:col-span-7 lg:col-span-8 fade-up fade-up-delay-2">
        <div
          id="hero-rotator"
          class="photo-frame aspect-[4/3] md:aspect-[16/10] lg:aspect-[16/9] w-full"
        >
          {
            featured.map((photo, i) => (
              <img
                src={photo.src}
                alt={photo.alt}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                class:list={[
                  'hero-photo absolute inset-0 w-full h-full object-cover hero-fade',
                  i !== 0 && 'hidden',
                ]}
                data-hero-index={i}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ heroSlugs }}>
  // Pick a random hero photo on each page load
  (function () {
    const rotator = document.getElementById('hero-rotator');
    if (!rotator) return;
    const photos = rotator.querySelectorAll('.hero-photo');
    if (photos.length <= 1) return;
    photos.forEach((p) => p.classList.add('hidden'));
    const idx = Math.floor(Math.random() * photos.length);
    photos[idx].classList.remove('hidden');
  })();
</script>
