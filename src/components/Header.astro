---
import { categories } from '../data/photos.js';
import { site } from '../data/site.js';

interface Props {
  activeNav?: string;
}

const { activeNav } = Astro.props;
---

<header class="border-b border-line/60">
  <div class="max-w-gallery mx-auto px-6 md:px-10 py-6 md:py-8">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <a href="/" class="group inline-flex flex-col">
        <span class="font-serif text-2xl md:text-3xl font-light leading-none text-ink group-hover:text-accent transition-colors duration-500 ease-soft">
          {site.name}
        </span>
        <span class="eyebrow mt-2">{site.tagline}</span>
      </a>

      <nav class="flex flex-wrap gap-x-6 gap-y-3 md:justify-end" aria-label="Primary">
        {
          categories.map((cat) => (
            <a
              href={`/${cat.slug}/`}
              class:list={[
                'nav-link',
                activeNav === cat.slug && 'nav-link-active',
              ]}
            >
              {cat.name}
            </a>
          ))
        }
        <a
          href="/about/"
          class:list={['nav-link', activeNav === 'about' && 'nav-link-active']}
        >
          About
        </a>
      </nav>
    </div>
  </div>
</header>
