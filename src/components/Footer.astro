---
import { site } from '../data/site.js';
---

<footer class="border-t border-line/60 mt-24 md:mt-32">
  <div class="max-w-gallery mx-auto px-6 md:px-10 py-10 md:py-12">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <p class="eyebrow">
        © {site.copyrightYear} {site.name} — All rights reserved
      </p>
      <p class="eyebrow">
        <a
          href={`mailto:${site.contactEmail}`}
          class="hover:text-ink transition-colors duration-300 ease-soft"
        >
          {site.contactEmail}
        </a>
      </p>
    </div>
  </div>
</footer>
