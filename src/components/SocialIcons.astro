---
import { site } from '../data/site.js';

interface Props {
  size?: number;
  gap?: string;
  className?: string;
}

const { size = 22, gap = 'gap-5', className = '' } = Astro.props;
const px = `${size}px`;
---

<div class:list={['flex items-center', gap, className]}>
  <a
    href={`mailto:${site.contactEmail}`}
    aria-label={`Email ${site.contactEmail}`}
    title={site.contactEmail}
    class="text-muted hover:text-ink transition-colors duration-300 ease-soft"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={px}
      height={px}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="3" y="5" width="18" height="14" rx="2"></rect>
      <path d="M3 7l9 6 9-6"></path>
    </svg>
  </a>
  <a
    href={site.instagramUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Instagram @${site.instagram}`}
    title={`@${site.instagram}`}
    class="text-muted hover:text-ink transition-colors duration-300 ease-soft"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={px}
      height={px}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="3" y="3" width="18" height="18" rx="5"></rect>
      <circle cx="12" cy="12" r="4"></circle>
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
    </svg>
  </a>
</div>
