---
import Base from '../../layouts/Base.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import LocationFilter from '../../components/LocationFilter.astro';
import {
  categoryBySlug,
  photosByCategory,
  travelLocationsByRegion,
} from '../../data/photos.js';

const category = categoryBySlug('travel');
const photos = photosByCategory('travel');
const groups = travelLocationsByRegion();
const locationCount = groups.reduce((sum, g) => sum + g.locations.length, 0);
---

<Base
  title={category.name}
  description={category.description}
  activeNav="travel"
>
  <section class="max-w-gallery mx-auto px-6 md:px-10 pt-8 md:pt-12 pb-16 md:pb-24">
    <header class="max-w-prose mb-8 md:mb-10 fade-up">
      <p class="eyebrow mb-3">Category</p>
      <h1 class="display text-ink">{category.name}</h1>
      <p class="body-serif text-muted mt-5">{category.description}</p>
      <p class="eyebrow mt-6 text-muted">
        {photos.length} {photos.length === 1 ? 'photograph' : 'photographs'}
        {locationCount > 0 && (
          <span> · {locationCount} {locationCount === 1 ? 'place' : 'places'}</span>
        )}
      </p>
    </header>

    {groups.length > 0 && <LocationFilter groups={groups} />}

    {
      photos.length > 0 ? (
        <PhotoGrid photos={photos} showLocations={true} />
      ) : (
        <div class="py-24 text-center">
          <p class="eyebrow text-muted">No photographs yet.</p>
        </div>
      )
    }
  </section>
</Base>
