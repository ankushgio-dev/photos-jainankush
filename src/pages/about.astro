---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
---

<Base title="About" activeNav="about">
  <section class="max-w-gallery mx-auto px-6 md:px-10 py-16 md:py-28">
    <div class="grid grid-cols-12 gap-6 md:gap-12">
      <div class="col-span-12 md:col-span-7 lg:col-span-6 fade-up">
        <p class="eyebrow mb-4">About</p>
        <h1 class="display text-ink">A note from the photographer.</h1>

        <div class="mt-10 space-y-6 text-muted body-serif">
          <p class="text-ink text-xl md:text-2xl font-serif font-light leading-snug">
            {site.bio}
          </p>

          <p>
            I started photographing because I wanted to look more carefully at the places I already know — the fields outside Ludhiana, the long corridors at Sri Harmandir Sahib, the small things in villages I had walked past all my life.
          </p>

          <p>
            Over time the camera has taken me further: to the cold deserts of Ladakh and Spiti, to the coasts of Goa, to wherever the road and the light cooperate.
          </p>

          <p>
            This site is a small, slow collection of what I have made along the way. I have hidden the technical details on purpose — the camera, the settings, the post — because I would like the photographs to stand for themselves.
          </p>
        </div>

        <div class="mt-14 pt-10 border-t border-line/60 fade-up fade-up-delay-2">
          <p class="eyebrow mb-3">Get in touch</p>
          <p class="body-serif text-muted max-w-prose mb-6">
            {site.contactNote}
          </p>
          <a
            href={`mailto:${site.contactEmail}`}
            class="inline-flex items-baseline gap-3 font-serif text-2xl md:text-3xl font-light text-ink hover:text-accent transition-colors duration-500 ease-soft"
          >
            <span>{site.contactEmail}</span>
            <span class="text-base">→</span>
          </a>
        </div>
      </div>

      <aside class="col-span-12 md:col-span-5 lg:col-span-5 lg:col-start-8 fade-up fade-up-delay-3">
        <div class="md:sticky md:top-12">
          <div class="photo-frame aspect-[4/5]">
            <img
              src="/photos/hero/about.jpg"
              alt="A photograph"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover"
              onerror="this.style.display='none'; this.parentElement.classList.add('bg-line/60');"
            />
          </div>
          <p class="eyebrow mt-4 text-right">Ludhiana, Punjab</p>
        </div>
      </aside>
    </div>
  </section>
</Base>
