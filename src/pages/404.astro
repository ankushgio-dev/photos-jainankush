---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="max-w-gallery mx-auto px-6 md:px-10 py-32 md:py-48 text-center">
    <p class="eyebrow mb-4 fade-up">404</p>
    <h1 class="display text-ink fade-up fade-up-delay-1">Nothing here.</h1>
    <p class="body-serif text-muted mt-6 fade-up fade-up-delay-2 max-w-prose mx-auto">
      The page you were looking for has moved or never existed. Try the homepage.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 mt-10 text-xs uppercase tracking-widest text-ink hover:text-accent transition-colors duration-300 ease-soft fade-up fade-up-delay-3"
    >
      <span class="w-8 h-px bg-ink"></span>
      Go home
    </a>
  </section>
</Base>
