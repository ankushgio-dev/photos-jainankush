---
import Base from '../layouts/Base.astro';
import HeroRotator from '../components/HeroRotator.astro';
import CategoryTile from '../components/CategoryTile.astro';
import { categories } from '../data/photos.js';
---

<Base activeNav="home">
  <HeroRotator />

  <section id="categories" class="border-t border-line/60">
    <div class="max-w-gallery mx-auto px-6 md:px-10 pt-10 md:pt-14 pb-6 md:pb-8">
      <div class="max-w-prose">
        <p class="eyebrow mb-3">The Work</p>
        <h2 class="display text-ink">By category</h2>
        <p class="body-serif text-muted mt-4">
          Each section is a slow build — I add photographs as I find them worth showing.
        </p>
      </div>
    </div>

    <div class="max-w-gallery mx-auto px-6 md:px-10 pb-16 md:pb-24">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12 md:gap-y-14">
        {categories.map((cat, i) => <CategoryTile category={cat} index={i} />)}
      </div>
    </div>
  </section>
</Base>
